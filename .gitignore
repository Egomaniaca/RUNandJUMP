# Unreal Engine project — ignore generated, cached and local files.
# Keep: Config/, Content/, Source/, *.uproject, and the repo docs.

# Build / compile output
Binaries/
Build/
!BuildConfiguration/
DerivedDataCache/
Intermediate/
Saved/

# Editor / tooling
.vs/
.vscode/
.idea/
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Plugins can also carry generated folders
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Local, machine-specific MCP client config (see docs/mcp-unreal-setup.md)
.mcp.json

# Python bytecode
__pycache__/
*.pyc
